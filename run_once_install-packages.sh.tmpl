{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash

set -xe

# Safe to re-run: --needed skips installed packages. Upgrade and install in one transaction
# (installing with a stale sync db, or -Sy without -u, is an unsupported partial upgrade on Arch).
sudo pacman -Syu --needed --noconfirm \
{{ range .packages.arch.pacman -}}
    {{ . }} \
{{ end -}}

# Install yay if necessary
if ! command -v yay >/dev/null 2>&1; then
    tmpdir="$(mktemp -d)"

    git clone https://aur.archlinux.org/yay.git "$tmpdir/yay"
    cd "$tmpdir/yay"
    makepkg -si --noconfirm

    rm -rf "$tmpdir"
fi

# AUR
if command -v yay >/dev/null 2>&1; then
    yay -S --needed --noconfirm {{ range .packages.arch.aur }}{{ . }} {{ end }}
else
    echo "yay is not installed; skipping AUR packages."
fi

# Reload input method config (fails when fcitx5 isn't running, e.g. first install)
fcitx5-remote -r || true

{{ end -}}

